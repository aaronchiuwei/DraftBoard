# Accounts and cloud sync. Copy to .env.local to switch them on.
#
# Leave these unset and the app behaves exactly as it did before accounts
# existed: no sign-in screen, storage on the device only, and none of the
# Supabase SDK in the bundle.
#
# Project URL: Settings → API → Project URL
# Key: Settings → API Keys → Publishable key (sb_publishable_...).
# Never use a Secret key. Row-level security in supabase/schema.sql is what
# keeps one account's draft away from another's.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
