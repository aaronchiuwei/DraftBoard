{
  "name": "draft-board",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first draft tracker for a live, in-person PPR fantasy football draft.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "depth": "node scripts/fetch-depth.mjs",
    "injuries": "node scripts/fetch-injuries.mjs",
    "teams": "node scripts/fetch-teams.mjs",
    "research": "node scripts/build-research-data.mjs",
    "stats": "node scripts/fetch-stats.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronchiuwei/DraftBoard.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "happy-dom": "^20.11.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "preact": "^10.29.8"
  }
}
